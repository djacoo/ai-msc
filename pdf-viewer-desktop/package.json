{
  "name": "pdf-viewer-desktop",
  "version": "1.0.0",
  "description": "Desktop PDF Viewer with AI Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "install": "./build-and-install.sh",
    "update": "./quick-update.sh"
  },
  "keywords": ["electron", "pdf", "ai", "ollama"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.aimasternotes.pdfviewer",
    "productName": "AI Masters PDF Viewer",
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
